{
	"name": "hylbee/anchor-dynamic-url-dev",
	"description": "Development tooling for the Anchor Dynamic URL WordPress plugin (not shipped with the plugin).",
	"type": "project",
	"license": "GPL-2.0-or-later",
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"lint": "phpcs",
		"version-check": "@php bin/version.php",
		"build": "@php bin/build-zip.php",
		"test:integration": "bash bin/test-integration.sh"
	}
}
