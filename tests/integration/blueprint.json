{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true,
				"WP_DEBUG_LOG": true,
				"WP_DEBUG_DISPLAY": false,
				"DISABLE_WP_CRON": true,
				"FS_METHOD": "direct"
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"permalink_structure": "/%postname%/"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "elementor"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "anchor-dynamic-url/anchor-dynamic-url.php"
		}
	]
}
